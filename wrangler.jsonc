{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flarefleet",
  "main": "./worker/index.ts",
  // Hostname the Worker is served on. Its zone must be on the deploying Cloudflare
  // account; set the build variable CUSTOM_DOMAIN to use a different one, or
  // CUSTOM_DOMAIN=none to serve only on workers.dev.
  "routes": [{ "pattern": "fuhrpark.woodnet.cc", "custom_domain": true }],
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The React SPA is served as static assets; everything under /api and the
  // public QR endpoint runs in the Worker first.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    "APP_NAME": "FlareFleet",
    // Public URL of this deployment (used in QR labels and e-mails). Follows the
    // Custom Domain above; leave empty to fall back to the URL the app was first
    // reached at. A value set in Settings → Public URL overrides it.
    "PUBLIC_BASE_URL": "https://fuhrpark.woodnet.cc",
    // Default sender address; the super admin can override it in the app (Settings → E-mail).
    // Must belong to a domain onboarded in Cloudflare Email Service (Compute → Email Service → Email Sending).
    "EMAIL_FROM": "fuhrpark@woodnet.cc",
    // Set to "false" to disable e-mail sending entirely.
    "EMAIL_ENABLED": "true",
    // Password hashing cost. Workers cap PBKDF2 at 100000; the free plan's 10 ms CPU
    // budget fits about 20000. Raise on a paid plan. Existing users are re-hashed on login.
    "PBKDF2_ITERATIONS": "20000"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flarefleet-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "flarefleet-media" }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "VEHICLE_LOCK", "class_name": "VehicleLock" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VehicleLock"] }
  ],
  "send_email": [
    { "name": "EMAIL" }
  ],
  "triggers": {
    // Every hour: purge never-attached staged uploads, retry pending/failed PDFs.
    // Daily 06:00 UTC: overdue-return e-mail digest.
    "crons": ["0 * * * *", "0 6 * * *"]
  }
}
